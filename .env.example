# Pathyam — environment configuration. Copy to .env and fill in.
# .env is gitignored. Never commit real keys.

# ---------------------------------------------------------------- database ----
# Postgres DSN. ./dev.sh writes a local one to engine/.devdata/dsn automatically.
PATHYAM_DSN=postgresql://user:password@localhost:5432/pathyam

# ------------------------------------------------------------------- CORS ----
# Comma-separated list of origins allowed to call this API cross-origin.
# REQUIRED in production: when unset and PATHYAM_ENV != development the allowlist
# is EMPTY, not "*". Credentials are enabled, so a wildcard is never valid here.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# development | production. Controls the CORS fallback above.
PATHYAM_ENV=development

# ------------------------------------------------------------ vision (VLM) ----
# OpenRouter API key for meal photo perception. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Vision model. Either an explicit OpenRouter id ("vendor/model"), or "auto" to
# select one from the live catalogue. There is deliberately no hardcoded default.
#
#   auto            same as auto:free
#   auto:free       zero-cost models first, falling back to the cheapest paid one
#                   when no free model is usable — so an emptying free tier
#                   degrades to a working paid call, not to no vision at all
#   auto:cheapest   lowest estimated cost per meal photo
#   auto:any        best capability, price ignored
#
# Inspect and check without an API key — OpenRouter's catalogue is public:
#
#     PYTHONPATH=. python3 -m pathyam_engine.vision --list        # usable, free first
#     PYTHONPATH=. python3 -m pathyam_engine.vision --select free # what auto picks
#     PYTHONPATH=. python3 -m pathyam_engine.vision <model-id>    # check one
#
# Automatic selection only ever picks a model that exists, accepts images, emits
# text, can return JSON, has a knowable price, and is not about to expire. An
# explicit id is never silently overridden.
#
# ⚠ FREE MODELS AND YOUR USERS' PHOTOGRAPHS
# Free OpenRouter endpoints are free because the provider may use what you send:
# OpenRouter's own documentation says most of them train on, or may publish, their
# inputs. What this sends is a photograph someone took of their meal, usually at
# home — personal data, adjacent to the health data this codebase already gates
# behind consent. Before pointing real users at a free model, either choose a paid
# id or turn off training-permitted routing in your OpenRouter privacy settings.
PATHYAM_VISION_MODEL=auto:free

# Optional. Point at any OpenAI-compatible gateway instead of OpenRouter —
# OmniRoute (self-hosted, github.com/diegosouzapw/OmniRoute), LiteLLM, a proxy.
#
#   PATHYAM_VISION_BASE_URL=http://localhost:20128/v1     # OmniRoute default port
#
# Off OpenRouter, PATHYAM_VISION_MODEL must name an explicit model id: "auto" ranks
# on OpenRouter's pricing, modality and capability fields, which another gateway's
# /models does not carry, and ranking absent fields would pick badly in silence.
#
# DEVELOPMENT ONLY — enforced, not just advised. A non-OpenRouter base URL is
# refused when PATHYAM_ENV=production, so an env var surviving a promotion cannot
# silently route users' meal photographs through a dev gateway.
#
# ⚠ DISABLE PROMPT COMPRESSION ON THE GATEWAY FOR THIS ROUTE.
# Gateways that rewrite prompts in flight — OmniRoute ships 12 compression engines
# on by default, advertised as transparent — are a specific hazard here. The system
# prompt says "do NOT calculate or guess nutrient figures" and "do not substitute a
# plausible South Indian dish for one you cannot actually see". Those negations are
# the boundary between perception and computation, and rule-based prose compression
# is exactly what drops a negation. On a json_object model the extraction schema
# also travels in the prompt. Use the gateway's passthrough profile or preservation
# guards; nothing on this side can detect a paraphrased instruction.
# PATHYAM_VISION_BASE_URL=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Set to 1 to use the offline mock vision provider (development only). This is now
# the ONLY way to reach the mock: a missing key or a failed call raises instead of
# degrading into it. Mock observations are stamped model_version="mock" so nothing
# downstream can mistake one for a real reading.
PATHYAM_MOCK_VISION=

# ------------------------------------------------------------ rate limiting ----
# Number of reverse proxies in front of this app. LEAVE AT 0 unless there really is
# one: with 0 the socket peer is used, which cannot be forged. Any non-zero value
# makes the app trust X-Forwarded-For, and trusting it when nothing rewrites it lets
# a caller present a new address per request — which does not weaken the per-IP limit,
# it removes it, while the metrics still show one running.
PATHYAM_TRUSTED_PROXY_HOPS=0

# ------------------------------------------------------------- literature ----
# Optional NCBI E-utilities key. Raises the rate limit from 3 to 10 req/sec.
# https://ncbiinsights.ncbi.nlm.nih.gov/2017/11/02/new-api-keys-for-the-e-utilities/
NCBI_API_KEY=

# ----------------------------------------------------------------- mobile ----
# Expo client target. Must be a LAN address or tunnel — localhost will not
# resolve from a physical device.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000

# ------------------------------------------------------------------ mail ----
# Outbound mail. Password reset is the only thing that uses it today.
#
# With SMTP_HOST unset, development uses a console mailer that writes the message
# to the log and sends nothing — which is what you want locally, and a credential
# leak in production: the reset token would reach an operator with log access
# instead of the user. build_mailer() therefore REFUSES to start with the console
# mailer when PATHYAM_ENV=production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=1
MAIL_FROM=no-reply@pathyam.app

# Base URL of the user-facing app, used to build the reset link. Without it the
# email carries the bare token instead.
PATHYAM_APP_URL=
